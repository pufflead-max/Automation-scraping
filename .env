# ============================================
# DOCKER COMPOSE CONFIGURATION
# ============================================
COMPOSE_PROJECT_NAME=automation-scraping

# ============================================
# MONGODB CONFIGURATION
# ============================================
# Root admin credentials (used by MongoDB container initialization)
MONGO_INITDB_ROOT_USERNAME=automation-scraping
MONGO_INITDB_ROOT_PASSWORD=Mongodb_password12345

# Application database and user
MONGO_DB=PUFF
APP_MONGO_USER=scraper_admin
APP_MONGO_PASSWORD=Mongodb_password12345

# MongoDB connection URI for application use
# Format: mongodb://username:password@host:port/database?authSource=authDB
# MONGO_URI=mongodb://scraper_admin:Mongodb_password12345@mongo:27017/PUFF?authSource=admin
MONGO_URI=mongodb://scraper_admin:Mongodb_password12345@72.60.113.252:47018/PUFF?authSource=PUFF

# External MongoDB port (host:container mapping is 47018:27017)
MONGO_PORT=47018

# ============================================
# AIRFLOW CONFIGURATION
# ============================================
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Airflow database (PostgreSQL)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow database connection (PostgreSQL)
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Airflow Webserver User
_AIRFLOW_WWW_USER_USERNAME=Edno
_AIRFLOW_WWW_USER_PASSWORD=Edno@Puff123

# ============================================
# SCRAPER CONFIGURATION
# ============================================
# ScraperAPI proxy configuration
SCRAPERAPI_KEY=5e9b52cabe6e868c1428c50f36d92382
SCRAPERAPI_PROXY=scraperapi.keep_headers=true:5e9b52cabe6e868c1428c50f36d92382@proxy-server.scraperapi.com:8001

# Scraping parameters
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_DELAY=5

# ============================================
# GOHIGHLEVEL CONFIGURATION
# ============================================
GHL_API_KEY=pit-8ca1de8b-9325-4d4a-8282-d11097f94247
GHL_LOCATION_ID=zamUBsYYpl1GwgSymuyW

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json



