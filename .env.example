# ============================================
# DOCKER COMPOSE CONFIGURATION
# ============================================
COMPOSE_PROJECT_NAME=automation-scraping

# ============================================
# MONGODB CONFIGURATION
# ============================================
# Root admin credentials (used by MongoDB container initialization)
MONGO_INITDB_ROOT_USERNAME=your_mongo_root_user
MONGO_INITDB_ROOT_PASSWORD=your_mongo_root_password

# Application database and user
MONGO_DB=PUFF
APP_MONGO_USER=scraper_admin
APP_MONGO_PASSWORD=your_app_mongo_password

# MongoDB connection URI for application use
# Format: mongodb://username:password@host:port/database?authSource=authDB
# MONGO_URI=mongodb://scraper_admin:your_app_mongo_password@mongo:27017/PUFF?authSource=admin
MONGO_URI=mongodb://scraper_admin:your_app_mongo_password@your_server_ip:47018/PUFF?authSource=PUFF

# External MongoDB port (host:container mapping is 47018:27017)
MONGO_PORT=47018

# ============================================
# AIRFLOW CONFIGURATION
# ============================================
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Airflow database (PostgreSQL)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow database connection (PostgreSQL)
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow:airflow@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=false

# Airflow Webserver User
_AIRFLOW_WWW_USER_USERNAME=your_airflow_username
_AIRFLOW_WWW_USER_PASSWORD=your_airflow_password
AIRFLOW__WEBSERVER__SECRET_KEY=your_random_secret_key_here

# ============================================
# SCRAPER CONFIGURATION
# ============================================
# ScraperAPI proxy configuration
SCRAPERAPI_KEY=your_scraperapi_key_here
SCRAPERAPI_PROXY=scraperapi.keep_headers=true:your_scraperapi_key_here@proxy-server.scraperapi.com:8001

# Scraping parameters
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_DELAY=5

# ============================================
# GOHIGHLEVEL CONFIGURATION
# ============================================
# Toggle: live or sandbox
GHL_ENVIRONMENT=live

# API Backwards compatibility
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_ghl_location_id_here

# SANDBOX (Legacy/Test Account)
GHL_SANDBOX_API_KEY=your_ghl_sandbox_api_key_here
GHL_SANDBOX_LOCATION_ID=your_ghl_sandbox_location_id_here
GHL_SANDBOX_CRM_URL=https://services.leadconnectorhq.com

# LIVE (Production Account)
GHL_LIVE_API_KEY=your_ghl_live_api_key_here
GHL_LIVE_LOCATION_ID=your_ghl_live_location_id_here
GHL_LIVE_CRM_URL=https://services.leadconnectorhq.com

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# SCRAPER AUTHENTICATION
# ============================================
FACEBOOK_EMAIL=your_facebook_email@example.com
FACEBOOK_PASSWORD=your_facebook_password
FACEBOOK_APP_PASSWORD=your_facebook_app_password
NEXTDOOR_EMAIL=your_nextdoor_email@example.com
NEXTDOOR_PASSWORD=your_nextdoor_password
NEXTDOOR_APP_PASSWORD=your_nextdoor_app_password

# ============================================
# CAPTCHA SOLVER CONFIGURATION
# ============================================
TWO_CAPTCHA_API_KEY=your_2captcha_api_key_here

# ============================================
# PROXY CONFIGURATION
# ============================================
# Bright Data Residential Proxy
BRIGHTDATA_PROXY_SERVER=brd.superproxy.io:33335
BRIGHTDATA_PROXY_USER=brd-customer-your_customer_id-zone-residential_proxy1-country-us
BRIGHTDATA_PROXY_PASS=your_brightdata_proxy_password

# ============================================
# AI CLOUD CONFIGURATION (Ollama Cloud)
# ============================================
OLLAMA_CLOUD_URL=http://ollama:11434/api/chat
OLLAMA_CLOUD_MODEL=qwen2.5:7b

# ============================================
# GOOGLE SHEETS SETTINGS
# ============================================
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_CREDENTIALS_PATH=google_credentials.json
